rules_version = '2';
// NLO Cases — Firestore security rules.
// Case bodies are encrypted in the browser; these rules decide WHO may read or
// write the ciphertext, keep the history log append-only, and stop anyone who
// is not an active member (or a removed member) from touching anything.
service cloud.firestore {
  match /databases/{db}/documents {
    function authed() { return request.auth != null; }
    function hasSetup() { return exists(/databases/$(db)/documents/meta/setup); }
    function isOwner() { return authed() && hasSetup() && get(/databases/$(db)/documents/meta/setup).data.owner == request.auth.uid; }
    function myDoc() { return /databases/$(db)/documents/members/$(request.auth.uid); }
    function isMember() { return authed() && exists(myDoc()) && get(myDoc()).data.active == true; }
    function mySid() { return get(myDoc()).data.staffId; }
    function curV() { return get(/databases/$(db)/documents/meta/keys).data.current; }
    // true only inside the one-time office setup batch, and only for the practice owner's
    // verified email address (stops anyone else claiming an empty office)
    function bootstrapping() {
      return authed() && !hasSetup()
        && request.auth.token.email == '__OWNER_EMAIL__' && request.auth.token.email_verified == true
        && getAfter(/databases/$(db)/documents/meta/setup).data.owner == request.auth.uid;
    }
    // a public key must look like a P-256 JWK (the owner's client also tolerates bad ones)
    function okPub(d) {
      return !('pub' in d) || (d.pub is map && d.pub.keys().hasOnly(['kty', 'crv', 'x', 'y'])
        && d.pub.kty == 'EC' && d.pub.crv == 'P-256' && d.pub.x is string && d.pub.y is string
        && d.pub.x.size() == 43 && d.pub.y.size() == 43);
    }
    // the front-desk email for cases not shipped in time (8 Oct 2026): on or off, the one address it may go to, which mailbox's
    // script sends it and that script's public key (the note is sealed to it), and whether it names the patient
    function okNotify(d) {
      return !('notify' in d) || (d.notify is map && d.notify.keys().hasOnly(['on', 'to', 'box', 'pub', 'names'])
        && d.notify.on is bool && d.notify.names is bool
        && d.notify.to is string && d.notify.to.size() <= 120 && d.notify.to.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && d.notify.box is string && d.notify.box.matches('^(b[0-9a-f]{32})?$') && okPub(d.notify));
    }

    match /meta/setup {
      allow get: if isMember();
      allow create: if bootstrapping()
        && request.resource.data.keys().hasOnly(['owner', 'at'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.at == request.time
        && getAfter(myDoc()).data.role == 'owner';
      allow update, delete: if false;
    }
    match /meta/keys {
      allow get: if isMember();
      allow create: if bootstrapping() && request.resource.data.keys().hasOnly(['current']) && request.resource.data.current == 1;
      allow update: if isOwner() && request.resource.data.keys().hasOnly(['current'])
        && request.resource.data.current == resource.data.current + 1;
      allow delete: if false;
    }
    match /meta/settings {
      allow get: if isMember();
      allow create: if bootstrapping() || isOwner();
      allow update: if isOwner();
      allow delete: if false;
    }
    match /meta/recovery {
      allow get: if isOwner();
      allow create: if bootstrapping() || isOwner();
      allow update: if isOwner();
      allow delete: if false;
    }
    // username -> sign-in address. Readable one at a time (needed before sign-in), never listable.
    match /logins/{name} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isOwner() && request.resource.data.keys().hasOnly(['email']) && request.resource.data.email is string;
      allow delete: if isOwner();
    }
    match /members/{uid} {
      allow get: if authed() && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();
      allow create: if (isOwner() && request.resource.data.role == 'staff')
        || (bootstrapping() && uid == request.auth.uid && request.resource.data.role == 'owner' && request.resource.data.active == true);
      // the owner manages everyone (and can never demote themself); a person may only
      // update their own key material, and only while still active
      allow update: if (isOwner() && (uid != request.auth.uid || (request.resource.data.role == 'owner' && request.resource.data.active == true)))
        || (authed() && request.auth.uid == uid && resource.data.active == true
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['pub']) || okPub(request.resource.data))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pub', 'priv', 'privPrev', 'ring', 'ringV', 'boot', 'mustSetup', 'lastLogin']));
      allow delete: if false;
    }
    match /roster/{sid} {
      // (NLO Time Clock: the office's time-clock computer shows each person's name and photo; its alert script names them;
      // an approved laptop reads only the people it's for)
      allow read: if isMember() || isTcDevice();
      allow get: if lapHas(sid);
      allow create, update: if isOwner() || bootstrapping();
      allow delete: if false;
    }
    // Every write to a case must come with a history entry, at the fixed id "<case>_<rev>",
    // holding the previous encrypted copy. History can't be edited or deleted, so any
    // overwrite — buggy, careless or malicious — can be undone from it.
    function histAfter(id, rev) { return existsAfter(/databases/$(db)/documents/log/$(id + '_' + string(rev))); }
    // The patient index (4 Oct 2026): pn / pc are keyed hashes (HMAC with a key derived from the office key) of the
    // patient's name and chart #, so an app can fetch one patient's earlier cases instead of every completed case.
    // Without the office key they say nothing about who the patient is.
    function okIdx(d) {
      return (!('pn' in d) || (d.pn is string && d.pn.size() == 22)) && (!('pc' in d) || (d.pc is string && d.pc.size() == 22));
    }
    match /cases/{id} {
      function okCase() {
        let d = request.resource.data;
        return d.keys().hasOnly(['v', 'iv', 'ct', 'status', 'rev', 'by', 'sid', 'createdAt', 'updatedAt', 'closedAt', 'pn', 'pc'])
          && d.v == curV() && d.iv is string && d.ct is string && d.ct.size() < 600000
          && d.rev is int && d.by == request.auth.uid && d.sid == mySid()
          && d.updatedAt == request.time && okIdx(d)
          && ((d.status == 'open' && d.closedAt == null) || (d.status == 'done' && d.closedAt is timestamp));
      }
      allow read: if isMember();
      allow create: if isMember() && okCase() && request.resource.data.rev == 1
        && request.resource.data.createdAt == request.time && histAfter(id, 1);
      allow update: if isMember() && okCase() && request.resource.data.rev == resource.data.rev + 1
        && request.resource.data.createdAt == resource.data.createdAt && histAfter(id, request.resource.data.rev);
      // the index alone (the owner's app indexing the office, or catching up on a case an older copy of the app saved):
      // nothing about the case itself changes, so no new version
      allow update: if isMember() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pn', 'pc'])
        && okIdx(request.resource.data);
      allow delete: if isOwner() && histAfter(id, resource.data.rev + 1);
    }
    match /log/{lid} {
      function caseBefore() { return /databases/$(db)/documents/cases/$(request.resource.data.caseId); }
      function okHist() {
        let d = request.resource.data;
        return (exists(caseBefore()) && d.rev == get(caseBefore()).data.rev + 1
                 && d.prev == {'v': get(caseBefore()).data.v, 'iv': get(caseBefore()).data.iv, 'ct': get(caseBefore()).data.ct})
          || (!exists(caseBefore()) && d.rev == 1 && d.prev == null);
      }
      function okAfter() {
        let d = request.resource.data;
        return (existsAfter(caseBefore()) && getAfter(caseBefore()).data.rev == d.rev)
          || (!existsAfter(caseBefore()) && exists(caseBefore()) && isOwner());
      }
      // del: marks the entry of a deleted case (so Deleted cases reads only those, not every recent entry)
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['caseId', 'rev', 'uid', 'sid', 'at', 'v', 'iv', 'ct', 'prev', 'del'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.sid == mySid()
        && request.resource.data.at == request.time && request.resource.data.caseId is string
        && request.resource.data.rev is int && lid == request.resource.data.caseId + '_' + string(request.resource.data.rev)
        && request.resource.data.v is int && request.resource.data.ct is string && request.resource.data.ct.size() < 20000
        && (!('del' in request.resource.data) || (request.resource.data.del == true && !existsAfter(caseBefore())))
        && okHist() && okAfter();
      allow update, delete: if false;
    }
    // which set of these rules is live: the app reads this (it needn't exist); older rules refuse it
    match /meta/rules_20261004 {
      allow get: if isMember();
    }
    match /meta/rules_20261008 {
      allow get: if isMember();
    }

    // ---------- patient photos ----------
    // One small picture per case, sealed in the browser with the office key like the case itself.
    // It changes only together with a save of its case (so the case's history shows who added or
    // changed it), or with a brand-new case; the owner re-seals pictures unchanged after a key change.
    function caseDoc(id) { return /databases/$(db)/documents/cases/$(id); }
    function caseSavedNow(id) { return exists(caseDoc(id)) && existsAfter(caseDoc(id)) && getAfter(caseDoc(id)).data.rev == get(caseDoc(id)).data.rev + 1; }
    match /photos/{id} {
      function okPhoto() {
        let d = request.resource.data;
        return d.keys().hasOnly(['v', 'iv', 'ct', 'pv', 'at', 'by']) && d.v == curV()
          && d.iv is string && d.iv.size() <= 24 && d.ct is string && d.ct.size() <= 90000
          && d.pv is string && d.pv.size() > 0 && d.pv.size() <= 20
          && d.by == request.auth.uid && d.at == request.time;
      }
      allow get: if isMember();
      allow list: if isOwner();
      allow create: if isMember() && okPhoto() && existsAfter(caseDoc(id)) && (!exists(caseDoc(id)) || caseSavedNow(id));
      allow update: if isMember() && okPhoto() && existsAfter(caseDoc(id))
        && (caseSavedNow(id) || (isOwner() && request.resource.data.pv == resource.data.pv));
      allow delete: if isMember() && (!existsAfter(caseDoc(id)) || caseSavedNow(id));
    }

    // ---------- lab-email updates ----------
    // A small Google Apps Script in the office's Gmail accounts forwards lab emails, sealed to the office
    // inbox key so only the app can open them. Its own login (made by the owner) can add sealed items to the
    // inbox and note when it last checked the mail. It can't read or change anything else.
    function isBot() { return authed() && exists(/databases/$(db)/documents/mailbots/$(request.auth.uid)); }
    match /mailbots/{uid} {
      allow get: if authed() && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();
      allow create: if isOwner() && request.resource.data.keys().hasOnly(['email', 'at'])
        && request.resource.data.email is string && request.resource.data.at == request.time;
      allow delete: if isOwner();
      allow update: if false;
    }
    // the inbox public key the robot seals to (and which senders to forward)
    match /meta/inbox {
      allow get: if isMember() || isBot();
      allow create, update: if isOwner() && request.resource.data.keys().hasOnly(['pub', 'kid', 'senders', 'at', 'notify'])
        && 'pub' in request.resource.data && okPub(request.resource.data)
        && request.resource.data.kid is string && request.resource.data.kid.size() <= 40
        && request.resource.data.senders is list && request.resource.data.senders.size() <= 40
        && okNotify(request.resource.data);
      allow delete: if false;
    }
    // its private half, sealed with the office key
    match /meta/inboxKey {
      allow get: if isMember();
      allow create, update: if isOwner();
      allow delete: if false;
    }
    // the robot's login, sealed with the office key, so the owner can show the script again
    match /meta/mailbot {
      allow get, create, update, delete: if isOwner();
    }
    match /inbox/{id} {
      allow create: if isBot() && id.matches('^m[0-9a-f]{40}$')
        && request.resource.data.keys().hasOnly(['kid', 'epk', 'iv', 'ct', 'at'])
        && request.resource.data.kid is string && request.resource.data.kid.size() <= 40
        && request.resource.data.epk is map && request.resource.data.epk.keys().hasOnly(['kty', 'crv', 'x', 'y'])
        && request.resource.data.iv is string && request.resource.data.iv.size() <= 24
        && request.resource.data.ct is string && request.resource.data.ct.size() <= 400000
        && request.resource.data.at == request.time;
      allow get, list: if isMember();
      // staff mark which updates in an email are dealt with (and which open app is handling it), and remove it once all are
      // (a claim is checked only when it changes — marking updates done keeps the earlier claim as it was)
      allow update: if isMember() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'claim'])
        && (!('done' in request.resource.data) || (request.resource.data.done is list && request.resource.data.done.size() <= 200))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['claim'])
            || (request.resource.data.claim is map && request.resource.data.claim.keys().hasOnly(['by', 'at'])
                && request.resource.data.claim.by is string && request.resource.data.claim.by.size() <= 20 && request.resource.data.claim.at == request.time));
      allow delete: if isMember();
    }
    // when each mailbox's script last checked the mail (no patient data)
    match /mailbeat/{id} {
      allow get, list: if isMember();
      // (pub: the key a newer script opens front-desk notes with — its private half stays in that Gmail account)
      allow create, update: if isBot() && id.matches('^b[0-9a-f]{32}$')
        && request.resource.data.keys().hasOnly(['box', 'at', 'seen', 'sent', 'err', 'ver', 'pub']) && okPub(request.resource.data)
        && request.resource.data.box is string && request.resource.data.box.size() <= 120
        && request.resource.data.at == request.time
        && request.resource.data.seen is int && request.resource.data.sent is int
        && request.resource.data.err is string && request.resource.data.err.size() <= 300
        && request.resource.data.ver is string && request.resource.data.ver.size() <= 20;
      allow delete: if isOwner();
    }

    // ---------- a note for the front desk (Amir, 8 Oct 2026: "when the case gets delayed (not shipped by the expected time)
    // please also send a email to Questions@thenextlevelorthodontics.com to let the front desk know") ----------
    // An open app adds a note here in the same save that marks the case as emailed, sealed to one mailbox script's own key
    // (its private half never leaves that Gmail account). That script opens it, emails meta/inbox's front-desk address — the
    // only address it sends these to — and removes it. Nobody else can read it.
    match /outbox/{id} {
      allow create: if isMember() && id.matches('^o[0-9a-f]{32}$')
        && request.resource.data.keys().hasOnly(['box', 'epk', 'iv', 'ct', 'at'])
        && request.resource.data.box is string && request.resource.data.box.matches('^b[0-9a-f]{32}$')
        && request.resource.data.epk is map && request.resource.data.epk.keys().hasOnly(['kty', 'crv', 'x', 'y'])
        && request.resource.data.iv is string && request.resource.data.iv.size() <= 24
        && request.resource.data.ct is string && request.resource.data.ct.size() <= 20000
        && request.resource.data.at == request.time;
      allow get, list: if isBot();
      allow delete: if isBot() || isOwner();
      allow update: if false;
    }

    // ---------- NLO Leads (same office, same logins, same key ring) ----------
    // Leads follow the same pattern as cases: sealed in the browser, every write comes with an
    // append-only history entry ("leadLog/<lead>_<rev>") holding the copy it replaced.
    function leadHistAfter(id, rev) { return existsAfter(/databases/$(db)/documents/leadLog/$(id + '_' + string(rev))); }
    match /leads/{id} {
      function okLead() {
        let d = request.resource.data;
        return d.keys().hasOnly(['v', 'iv', 'ct', 'status', 'rev', 'by', 'sid', 'createdAt', 'updatedAt', 'closedAt'])
          && d.v == curV() && d.iv is string && d.ct is string && d.ct.size() < 300000
          && d.rev is int && d.by == request.auth.uid && d.sid == mySid()
          && d.updatedAt == request.time
          && ((d.status == 'open' && d.closedAt == null) || (d.status == 'done' && d.closedAt is timestamp));
      }
      allow read: if isMember();
      allow create: if isMember() && okLead() && request.resource.data.rev == 1
        && request.resource.data.createdAt == request.time && leadHistAfter(id, 1);
      allow update: if isMember() && okLead() && request.resource.data.rev == resource.data.rev + 1
        && request.resource.data.createdAt == resource.data.createdAt && leadHistAfter(id, request.resource.data.rev);
      allow delete: if isOwner() && leadHistAfter(id, resource.data.rev + 1);
    }
    match /leadLog/{lid} {
      function leadBefore() { return /databases/$(db)/documents/leads/$(request.resource.data.leadId); }
      function okLeadHist() {
        let d = request.resource.data;
        return (exists(leadBefore()) && d.rev == get(leadBefore()).data.rev + 1
                 && d.prev == {'v': get(leadBefore()).data.v, 'iv': get(leadBefore()).data.iv, 'ct': get(leadBefore()).data.ct})
          || (!exists(leadBefore()) && d.rev == 1 && d.prev == null);
      }
      function okLeadAfter() {
        let d = request.resource.data;
        return (existsAfter(leadBefore()) && getAfter(leadBefore()).data.rev == d.rev)
          || (!existsAfter(leadBefore()) && exists(leadBefore()) && isOwner());
      }
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['leadId', 'rev', 'uid', 'sid', 'at', 'v', 'iv', 'ct', 'prev'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.sid == mySid()
        && request.resource.data.at == request.time && request.resource.data.leadId is string
        && request.resource.data.rev is int && lid == request.resource.data.leadId + '_' + string(request.resource.data.rev)
        && request.resource.data.v is int && request.resource.data.ct is string && request.resource.data.ct.size() < 20000
        && okLeadHist() && okLeadAfter();
      allow update, delete: if false;
    }
    // Website requests. Only the receiving service writes these (with its own server credentials,
    // which these rules don't apply to), sealed to the feed's public key. Staff remove one only by
    // filing it, in the same save, as a new open lead under the same id; the owner can remove one
    // that can't be opened.
    function leadDoc(id) { return /databases/$(db)/documents/leads/$(id); }
    match /leadInbox/{id} {
      allow read: if isMember();
      allow create, update: if false;
      allow delete: if isOwner() || (isMember() && !exists(leadDoc(id)) && existsAfter(leadDoc(id))
        && getAfter(leadDoc(id)).data.rev == 1 && getAfter(leadDoc(id)).data.status == 'open');
    }
    // the feed's key pair: public half in the clear (the service seals to it), private half sealed with the office key
    match /meta/intake {
      function okIntake() {
        let d = request.resource.data;
        return d.keys().hasOnly(['kid', 'pub', 'priv', 'at']) && d.kid is string && d.kid.size() < 40
          && 'pub' in d && okPub(d)
          && d.priv is map && d.priv.keys().hasOnly(['v', 'iv', 'ct']) && d.priv.v is int && d.priv.iv is string && d.priv.ct is string && d.priv.ct.size() < 2000
          && d.at is timestamp;
      }
      allow get: if isMember();
      allow create, update: if isOwner() && okIntake();
      allow delete: if false;
    }
    // the secret in the website's webhook address: its hash (checked by the service), a copy sealed for the owner, on/off
    match /meta/intakeSecret {
      function okSecret() {
        let d = request.resource.data;
        return d.keys().hasOnly(['hash', 'box', 'on', 'at']) && d.hash is string && d.hash.matches('^[0-9a-f]{64}$')
          && d.box is map && d.box.keys().hasOnly(['v', 'iv', 'ct']) && d.box.v is int && d.box.ct is string && d.box.ct.size() < 400
          && d.on is bool && d.at is timestamp;
      }
      allow get: if isOwner();
      allow create, update: if isOwner() && okSecret();
      allow delete: if false;
    }
    // when the receiving service last took or refused a request (times and a reason word only); written by the service
    match /meta/intakeStats {
      allow get: if isOwner();
      allow write: if false;
    }

    // ---------- NLO A/R (same office, same logins; its own key, only for the people Dr. A gives A/R to) ----------
    // Each person's copy of the A/R key ring is sealed to their own key pair (arAccess/<their uid>): these rules
    // decide who may read A/R at all, and only those people can open what they read. Reports from Edge and the
    // notes on each account are sealed in the browser; every save of an account keeps the copy it replaced.
    function arGrant() { return /databases/$(db)/documents/arAccess/$(request.auth.uid); }
    function isAR() { return isMember() && (isOwner() || exists(arGrant())); }
    function arCurV() { return get(/databases/$(db)/documents/meta/arKeys).data.current; }
    function okSealed(b, max) {
      return b is map && b.keys().hasOnly(['epk', 'iv', 'ct']) && b.epk is map && b.epk.keys().hasOnly(['kty', 'crv', 'x', 'y'])
        && b.iv is string && b.iv.size() <= 24 && b.ct is string && b.ct.size() <= max;
    }
    match /arAccess/{uid} {
      function okGrant() {
        let d = request.resource.data;
        let m = get(/databases/$(db)/documents/members/$(uid)).data;
        return d.keys().hasOnly(['ring', 'ringV', 'pubX', 'sid', 'by', 'at']) && okSealed(d.ring, 20000)
          && d.ringV is int && d.pubX is string && d.pubX.size() == 43 && d.sid is string && d.sid == m.staffId
          && m.active == true && d.by == request.auth.uid && d.at == request.time;
      }
      allow get: if (request.auth != null && request.auth.uid == uid && isMember()) || isOwner();
      allow list: if isOwner();
      allow create, update: if isOwner() && exists(/databases/$(db)/documents/members/$(uid)) && okGrant();
      allow delete: if isOwner();
    }
    match /meta/arKeys {
      allow get: if isAR();
      allow create: if isOwner() && request.resource.data.keys().hasOnly(['current']) && request.resource.data.current == 1;
      allow update: if isOwner() && request.resource.data.keys().hasOnly(['current']) && request.resource.data.current == resource.data.current + 1;
      allow delete: if false;
    }
    // a copy of the A/R key ring sealed to the office recovery key, so Dr. A's recovery code can always get it back
    match /meta/arEscrow {
      allow get: if isOwner();
      allow create, update: if isOwner() && request.resource.data.keys().hasOnly(['ring', 'ringV', 'recX', 'by', 'at'])
        && okSealed(request.resource.data.ring, 20000) && request.resource.data.ringV is int && request.resource.data.by == request.auth.uid;
      allow delete: if false;
    }
    // who has A/R (staff ids only), so accounts can be assigned to them
    match /meta/arTeam {
      allow get: if isAR();
      allow create, update: if isOwner() && request.resource.data.keys().hasOnly(['sids', 'at'])
        && request.resource.data.sids is list && request.resource.data.sids.size() <= 40;
      allow delete: if false;
    }
    // one change of the A/R key at a time, across Dr. A's screens (held for a moment while the key changes)
    match /meta/arKeyLock {
      allow get, delete: if isOwner();
      allow create, update: if isOwner() && request.resource.data.keys().hasOnly(['by', 'at'])
        && request.resource.data.by is string && request.resource.data.by.size() <= 80 && request.resource.data.at == request.time;
    }
    // which set of these rules is live (the app reads this; older rules refuse it)
    match /meta/rules_ar_1 {
      allow get: if isMember();
    }
    // An imported report: a small index doc (date, count, sealed totals) and the sealed report itself, saved together.
    // The person who imported it may take it back for a day; the owner any time.
    function arRep(id) { return get(/databases/$(db)/documents/arReports/$(id)).data; }
    function myFreshReport(id) { return arRep(id).uid == request.auth.uid && request.time < arRep(id).at + duration.value(1, 'd'); }
    match /arReports/{id} {
      function okRep() {
        let d = request.resource.data;
        return d.keys().hasOnly(['v', 'sum', 'asOf', 'n', 'uid', 'sid', 'at'])
          && d.v == arCurV() && d.sum is map && d.sum.keys().hasOnly(['iv', 'ct']) && d.sum.iv is string && d.sum.iv.size() <= 24
          && d.sum.ct is string && d.sum.ct.size() < 20000
          && d.asOf is string && d.asOf.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && d.n is int && d.n >= 0;
      }
      allow read: if isAR();
      allow create: if isAR() && okRep() && request.resource.data.uid == request.auth.uid && request.resource.data.sid == mySid()
        && request.resource.data.at == request.time && existsAfter(/databases/$(db)/documents/arReportData/$(id));
      // the owner re-seals it under a newer A/R key: same report, nothing else changes
      allow update: if isOwner() && okRep() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['v', 'sum']);
      allow delete: if (isOwner() || (isAR() && myFreshReport(id))) && !existsAfter(/databases/$(db)/documents/arReportData/$(id));
    }
    match /arReportData/{id} {
      function okData() {
        let d = request.resource.data;
        return d.keys().hasOnly(['v', 'iv', 'ct']) && d.v == arCurV() && d.iv is string && d.iv.size() <= 24 && d.ct is string && d.ct.size() < 1000000;
      }
      allow read: if isAR();
      allow create: if isAR() && okData() && !exists(/databases/$(db)/documents/arReports/$(id)) && existsAfter(/databases/$(db)/documents/arReports/$(id));
      allow update: if isOwner() && okData() && exists(/databases/$(db)/documents/arReports/$(id));
      allow delete: if (isOwner() || (isAR() && myFreshReport(id))) && !existsAfter(/databases/$(db)/documents/arReports/$(id));
    }
    // An account someone has worked (calls, notes, follow-up, resolved): saved like a case — sealed, and every write
    // comes with an append-only history entry ("arLog/<item>_<rev>") holding the copy it replaced.
    function arHistAfter(id, rev) { return existsAfter(/databases/$(db)/documents/arLog/$(id + '_' + string(rev))); }
    match /arItems/{id} {
      function okItem() {
        let d = request.resource.data;
        return d.keys().hasOnly(['v', 'iv', 'ct', 'status', 'rev', 'by', 'sid', 'createdAt', 'updatedAt'])
          && d.v == arCurV() && d.iv is string && d.iv.size() <= 24 && d.ct is string && d.ct.size() < 300000
          && d.rev is int && d.by == request.auth.uid && d.sid == mySid() && d.updatedAt == request.time
          && (d.status == 'open' || d.status == 'done');
      }
      allow read: if isAR();
      allow create: if isAR() && id.matches('^a[0-9A-Za-z_-]{22}$') && okItem() && request.resource.data.rev == 1
        && request.resource.data.createdAt == request.time && arHistAfter(id, 1);
      allow update: if isAR() && okItem() && request.resource.data.rev == resource.data.rev + 1
        && request.resource.data.createdAt == resource.data.createdAt && arHistAfter(id, request.resource.data.rev);
      // never deleted, so a record's history can't be restarted or skipped
      allow delete: if false;
    }
    match /arLog/{lid} {
      function itemBefore() { return /databases/$(db)/documents/arItems/$(request.resource.data.itemId); }
      function okArHist() {
        let d = request.resource.data;
        return (exists(itemBefore()) && d.rev == get(itemBefore()).data.rev + 1
                 && d.prev == {'v': get(itemBefore()).data.v, 'iv': get(itemBefore()).data.iv, 'ct': get(itemBefore()).data.ct})
          || (!exists(itemBefore()) && d.rev == 1 && d.prev == null);
      }
      function okArAfter() { return existsAfter(itemBefore()) && getAfter(itemBefore()).data.rev == request.resource.data.rev; }
      allow read: if isAR();
      allow create: if isAR()
        && request.resource.data.keys().hasOnly(['itemId', 'rev', 'uid', 'sid', 'at', 'v', 'iv', 'ct', 'prev'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.sid == mySid()
        && request.resource.data.at == request.time && request.resource.data.itemId is string
        && request.resource.data.rev is int && lid == request.resource.data.itemId + '_' + string(request.resource.data.rev)
        && request.resource.data.v == arCurV() && request.resource.data.iv is string && request.resource.data.iv.size() <= 24
        && request.resource.data.ct is string && request.resource.data.ct.size() < 20000
        && okArHist() && okArAfter();
      allow update, delete: if false;
    }

    // ---------- NLO Time Off (same office, same logins; its own HR key for the people who approve) ----------
    // Each request is sealed twice in the browser: to the HR key's public half (meta/toKeys.pub — the people who approve
    // hold its private half, toDrop/<version>, sealed with their HR key ring) and to the person's own key, so they can
    // read their own. In the clear: whose it is (staff id), its status and revision, and the day it starts (ms) — so the
    // rules can let someone cancel approved time off only before it starts. Every save keeps the copy it replaced.
    function toGrant() { return /databases/$(db)/documents/toAccess/$(request.auth.uid); }
    function isHR() { return isMember() && (isOwner() || exists(toGrant())); }
    function toCurV() { return get(/databases/$(db)/documents/meta/toKeys).data.current; }
    function toReqDoc(id) { return /databases/$(db)/documents/toReq/$(id); }
    match /toAccess/{uid} {
      function okToGrant() {
        let d = request.resource.data;
        let m = get(/databases/$(db)/documents/members/$(uid)).data;
        return d.keys().hasOnly(['ring', 'ringV', 'pubX', 'sid', 'by', 'at']) && okSealed(d.ring, 20000)
          && d.ringV is int && d.pubX is string && d.pubX.size() == 43 && d.sid is string && d.sid == m.staffId
          && m.active == true && d.by == request.auth.uid && d.at == request.time;
      }
      allow get: if (request.auth != null && request.auth.uid == uid && isMember()) || isOwner();
      allow list: if isOwner();
      allow create, update: if isOwner() && exists(/databases/$(db)/documents/members/$(uid)) && okToGrant();
      allow delete: if isOwner();
    }
    // the HR key's version and its public half (everyone seals new requests to it)
    match /meta/toKeys {
      function okToKeys() { let d = request.resource.data; return d.keys().hasOnly(['current', 'pub']) && d.current is int && 'pub' in d && okPub(d); }
      allow get: if isMember();
      allow create: if isOwner() && okToKeys() && request.resource.data.current == 1;
      allow update: if isOwner() && okToKeys() && request.resource.data.current == resource.data.current + 1;
      allow delete: if false;
    }
    // each version's private half, sealed with the HR key ring; never replaced
    match /toDrop/{v} {
      allow get, list: if isHR();
      allow create: if isOwner() && request.resource.data.keys().hasOnly(['v', 'iv', 'ct'])
        && request.resource.data.v is int && v == string(request.resource.data.v)
        && request.resource.data.iv is string && request.resource.data.iv.size() <= 24
        && request.resource.data.ct is string && request.resource.data.ct.size() <= 2000;
      allow update, delete: if false;
    }
    // a copy of the HR key ring sealed to the office recovery key, so Dr. A's recovery code can always get it back
    match /meta/toEscrow {
      allow get: if isOwner();
      allow create, update: if isOwner() && request.resource.data.keys().hasOnly(['ring', 'ringV', 'recX', 'by', 'at'])
        && okSealed(request.resource.data.ring, 20000) && request.resource.data.ringV is int && request.resource.data.by == request.auth.uid;
      allow delete: if false;
    }
    // who approves (staff ids only)
    match /meta/toTeam {
      allow get: if isMember();
      allow create, update: if isOwner() && request.resource.data.keys().hasOnly(['sids', 'at'])
        && request.resource.data.sids is list && request.resource.data.sids.size() <= 40;
      allow delete: if false;
    }
    // one change of the HR key at a time, across Dr. A's screens
    match /meta/toKeyLock {
      allow get, delete: if isOwner();
      allow create, update: if isOwner() && request.resource.data.keys().hasOnly(['by', 'at'])
        && request.resource.data.by is string && request.resource.data.by.size() <= 80 && request.resource.data.at == request.time;
    }
    // which set of these rules is live (the app reads this; older rules refuse it)
    match /meta/rules_to_1 {
      allow get: if isMember();
    }
    // level 2: scrubs requests (toPerk) — the page asks for the new rules until this one can be read
    match /meta/rules_to_2 {
      allow get: if isMember();
    }
    // each person's public key (the one their own login holds), so the people who approve can seal their copy to them
    match /toPeople/{sid} {
      function okPerson() {
        let d = request.resource.data;
        let m = get(/databases/$(db)/documents/members/$(d.uid)).data;
        return d.keys().hasOnly(['pub', 'uid', 'at']) && okPub(d) && d.uid is string && d.at == request.time
          && m.active == true && m.staffId == sid && m.pub == d.pub;
      }
      allow get, list: if isMember();
      allow create, update: if isMember() && okPerson() && (request.resource.data.uid == request.auth.uid || isOwner());
      allow delete: if isOwner();
    }
    function toHistAfter(id, rev) { return existsAfter(/databases/$(db)/documents/toLog/$(id + '_' + string(rev))); }
    match /toReq/{id} {
      function okReq() {
        let d = request.resource.data;
        return d.keys().hasOnly(['sid', 'status', 'rev', 'by', 'bsid', 'v', 'pub', 'startMs', 'hr', 'me', 'createdAt', 'updatedAt'])
          && d.sid is string && d.sid.size() > 0 && d.sid.size() <= 40
          && d.status in ['pending', 'approved', 'denied', 'cancelled', 'archived']
          && d.rev is int && d.by == request.auth.uid && d.bsid == mySid() && d.updatedAt == request.time
          && d.v == toCurV() && okSealed(d.hr, 30000) && (d.me == null || okSealed(d.me, 30000))
          && (d.pub == null || okPub(d)) && d.startMs is int && d.startMs > 946684800000 && d.startMs < 4102444800000;
      }
      // the person's own requests; the people who approve see everyone's (a request that doesn't exist yet can be looked
      // for, so a new one can be saved in a transaction)
      allow get: if isHR() || (isMember() && (resource == null || resource.data.sid == mySid()));
      allow list: if isHR() || (isMember() && resource.data.sid == mySid());
      // anyone may ask for their own time off; the people who approve may record it for someone (Dr. A only decides his own)
      allow create: if isMember() && okReq() && id.matches('^q[0-9a-f]{24}$') && request.resource.data.rev == 1
        && request.resource.data.createdAt == request.time && toHistAfter(id, 1)
        && (request.resource.data.status == 'pending' && request.resource.data.sid == mySid()
            || isHR() && (isOwner() || request.resource.data.sid != mySid() || request.resource.data.status == 'pending'));
      allow update: if isMember() && okReq() && request.resource.data.rev == resource.data.rev + 1
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.sid == resource.data.sid
        && toHistAfter(id, request.resource.data.rev)
        && (
          // the people who approve: someone else's request, anything (Dr. A: his own too). Their own request goes by
          // the same rules as anyone's (below) — so nobody who approves can change or undo their own approved time off
          (isHR() && (isOwner() || resource.data.sid != mySid()))
          // the person: change it or cancel it while it waits; cancel approved time off only before its first day
          || (resource.data.sid == mySid() && (
                (resource.data.status == 'pending' && request.resource.data.status in ['pending', 'cancelled'])
             || (resource.data.status == 'approved' && request.resource.data.status == 'cancelled'
                 && request.resource.data.startMs == resource.data.startMs && resource.data.startMs > request.time.toMillis())))
        );
      allow delete: if false;
    }
    match /toLog/{lid} {
      function reqBefore() { return toReqDoc(request.resource.data.reqId); }
      function okToHist() {
        let d = request.resource.data;
        return (exists(reqBefore()) && d.rev == get(reqBefore()).data.rev + 1 && d.osid == get(reqBefore()).data.sid
                 && d.prev == {'v': get(reqBefore()).data.v, 'hr': get(reqBefore()).data.hr, 'me': get(reqBefore()).data.me, 'status': get(reqBefore()).data.status})
          || (!exists(reqBefore()) && d.rev == 1 && d.prev == null);
      }
      function okToAfter() { return existsAfter(reqBefore()) && getAfter(reqBefore()).data.rev == request.resource.data.rev && getAfter(reqBefore()).data.sid == request.resource.data.osid; }
      allow get, list: if isHR() || (isMember() && resource.data.osid == mySid());
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['reqId', 'rev', 'uid', 'sid', 'osid', 'a', 'at', 'prev'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.sid == mySid()
        && request.resource.data.at == request.time && request.resource.data.reqId is string
        && request.resource.data.rev is int && lid == request.resource.data.reqId + '_' + string(request.resource.data.rev)
        && request.resource.data.a is string && request.resource.data.a.size() <= 20
        && okToHist() && okToAfter();
      allow update, delete: if false;
    }
    // who's out: one entry per approved request, sealed with the office key — everyone sees who's off and when, never why.
    // It changes only together with its request (or the owner seals it again after the office key changes).
    match /toOut/{id} {
      function outReq() { return toReqDoc(id); }
      function reqSavedNow() { return existsAfter(outReq()) && (!exists(outReq()) || getAfter(outReq()).data.rev == get(outReq()).data.rev + 1); }
      function okOut() {
        let d = request.resource.data;
        return d.keys().hasOnly(['v', 'iv', 'ct', 'at']) && d.v is int && d.iv is string && d.iv.size() <= 24
          && d.ct is string && d.ct.size() <= 4000 && d.at == request.time;
      }
      allow get, list: if isMember();
      allow create, update: if isMember() && okOut() && reqSavedNow() && getAfter(outReq()).data.status == 'approved';
      allow update: if isOwner() && okOut() && exists(outReq()) && get(outReq()).data.status == 'approved';
      allow delete: if (isMember() && reqSavedNow() && getAfter(outReq()).data.status != 'approved') || isOwner();
    }
    // each person's HR record (hire date, orientation, full/part-time, opening balance, adjustments): the HR key; Dr. A
    // writes it, and every save keeps the copy it replaced
    function toHRHistAfter(sid, rev) { return existsAfter(/databases/$(db)/documents/toHRLog/$(sid + '_' + string(rev))); }
    match /toHR/{sid} {
      function okHR() {
        let d = request.resource.data;
        return d.keys().hasOnly(['v', 'iv', 'ct', 'rev', 'by', 'updatedAt']) && d.v == toCurV()
          && d.iv is string && d.iv.size() <= 24 && d.ct is string && d.ct.size() < 200000
          && d.rev is int && d.by == request.auth.uid && d.updatedAt == request.time;
      }
      allow get, list: if isHR();
      allow create: if isOwner() && okHR() && request.resource.data.rev == 1 && toHRHistAfter(sid, 1);
      allow update: if isOwner() && okHR() && request.resource.data.rev == resource.data.rev + 1 && toHRHistAfter(sid, request.resource.data.rev);
      allow delete: if false;
    }
    match /toHRLog/{lid} {
      function hrBefore() { return /databases/$(db)/documents/toHR/$(request.resource.data.hsid); }
      function okHRHist() {
        let d = request.resource.data;
        return (exists(hrBefore()) && d.rev == get(hrBefore()).data.rev + 1
                 && d.prev == {'v': get(hrBefore()).data.v, 'iv': get(hrBefore()).data.iv, 'ct': get(hrBefore()).data.ct})
          || (!exists(hrBefore()) && d.rev == 1 && d.prev == null);
      }
      allow get, list: if isHR();
      allow create: if isOwner() && request.resource.data.keys().hasOnly(['hsid', 'rev', 'uid', 'at', 'a', 'prev'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.at == request.time
        && request.resource.data.hsid is string && request.resource.data.rev is int
        && lid == request.resource.data.hsid + '_' + string(request.resource.data.rev)
        && request.resource.data.a is string && request.resource.data.a.size() <= 20
        && okHRHist() && existsAfter(hrBefore()) && getAfter(hrBefore()).data.rev == request.resource.data.rev;
      allow update, delete: if false;
    }
    // each person's own copy of their HR record (sealed to them), so their app can work out their balance and statement
    match /toMine/{sid} {
      function okMine() {
        let d = request.resource.data;
        return d.keys().hasOnly(['box', 'pubX', 'at', 'by']) && okSealed(d.box, 200000)
          && d.pubX is string && d.pubX.size() == 43 && d.at == request.time && d.by == request.auth.uid;
      }
      allow get: if isMember() && (sid == mySid() || isHR());
      allow list: if isHR();
      allow create, update: if isOwner() && okMine();
      allow delete: if isOwner();
    }
    // the who's-out feed CADANCe and the office calendar read: names, dates and morning/afternoon, and how many requests
    // are waiting — sealed with a key kept in those apps' settings, never in a page. Anyone may fetch the sealed copy; any
    // member may write it (so a cancellation reaches the calendar at once): it shows nothing a member can't already see,
    // the readers check every value, and Dr. A's or an approver's next visit writes it afresh.
    match /toFeed/{id} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isMember() && id == 'live' && request.resource.data.keys().hasOnly(['iv', 'ct', 'at'])
        && request.resource.data.iv is string && request.resource.data.iv.size() <= 24
        && request.resource.data.ct is string && request.resource.data.ct.size() <= 200000 && request.resource.data.at == request.time;
      allow delete: if isOwner();
    }
    // scrubs (a yearly allowance): asked for with a reason and approved like time off — sealed the same two ways (the HR
    // key and the person's own key); in plain form only whose, the status and the year it counts against
    match /toPerk/{id} {
      function okPerk() {
        let d = request.resource.data;
        return d.keys().hasOnly(['sid', 'status', 'rev', 'by', 'bsid', 'v', 'pub', 'year', 'hr', 'me', 'createdAt', 'updatedAt'])
          && d.sid is string && d.sid.size() > 0 && d.sid.size() <= 40
          && d.status in ['pending', 'approved', 'denied', 'cancelled']
          && d.rev is int && d.by == request.auth.uid && d.bsid == mySid() && d.updatedAt == request.time
          && d.v == toCurV() && okSealed(d.hr, 8000) && (d.me == null || okSealed(d.me, 8000))
          && (d.pub == null || okPub(d)) && d.year is int && d.year >= 2000 && d.year < 2100;
      }
      allow get: if isHR() || (isMember() && (resource == null || resource.data.sid == mySid()));
      allow list: if isHR() || (isMember() && resource.data.sid == mySid());
      // anyone may ask for their own (waiting for approval), counted against this year (the office is on Eastern time, so
      // on Jan 1 in UTC — Dec 31 evening in Gainesville — last year is accepted too)
      allow create: if isMember() && okPerk() && id.matches('^p[0-9a-f]{24}$') && request.resource.data.rev == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'pending' && request.resource.data.sid == mySid()
        && (request.resource.data.year == request.time.year()
          || (request.resource.data.year == request.time.year() - 1 && request.time.month() == 1 && request.time.day() == 1));
      // the people who approve decide someone else's (Dr. A his own too); the person may change or cancel theirs while it waits
      allow update: if isMember() && okPerk() && request.resource.data.rev == resource.data.rev + 1
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.sid == resource.data.sid
        && request.resource.data.year == resource.data.year
        && ((isHR() && (isOwner() || resource.data.sid != mySid()))
          || (resource.data.sid == mySid() && resource.data.status == 'pending' && request.resource.data.status in ['pending', 'cancelled']));
      allow delete: if false;
    }
    // where Time Off's approved scrubs orders are emailed (NLO Cases' email robot reads it, and sends them nowhere else)
    match /meta/toMail {
      allow get: if isMember() || isBot();
      allow create, update: if isOwner() && request.resource.data.keys().hasOnly(['scrubs', 'at'])
        && request.resource.data.scrubs is string && request.resource.data.scrubs.size() <= 120
        && (request.resource.data.scrubs == '' || request.resource.data.scrubs.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$'))
        && request.resource.data.at == request.time;
      allow delete: if false;
    }
    // the feed's key, sealed with the office key
    match /meta/toFeedKey {
      allow get: if isMember();
      allow create, update: if isOwner() && request.resource.data.keys().hasOnly(['v', 'iv', 'ct', 'at'])
        && request.resource.data.v is int && request.resource.data.iv is string && request.resource.data.iv.size() <= 24
        && request.resource.data.ct is string && request.resource.data.ct.size() <= 400 && request.resource.data.at == request.time;
      allow delete: if false;
    }
    // ---------- NLO Time Clock (same office, same logins; Amir, 9 Oct 2026: "a robust custom clock time ... that sends me and
    // multiple people alerts when someone is getting close to overtime and set up boundaries") ----------
    // Staff clock in at the office's time-clock computer (its own login, made by Dr. A on that computer) with a 4-digit PIN.
    // The office lock (Amir, 9 Oct 2026: "only available when it's used inside the office", lock punching only, block
    // anywhere else): once Dr. A turns it on, they may also clock in on their own phone or computer, signed in, but only
    // on the office network — a small Cloudflare Worker (its own login, which can only write down networks) checks the
    // address right before the punch, and these rules take the punch only within 2 minutes of that, on a network Dr. A
    // saved as the office's, and only under the one-time punch number that check gave the page (one check, one punch).
    // From home: only on a laptop Dr. A approved, for the people he picked (with their PIN),
    // clocking in and out only, marked Home. Timesheets, approvals, payroll and settings work from anywhere.
    // A punch takes the server's time and is never changed or deleted: a correction is a new record (who, when, why), so
    // the original always stays visible. A PIN's hash is never readable — these rules compare against it — and each person gets 5 tries in 10 minutes, counted
    // before the PIN is checked. Someone who missed a punch asks for it (Amir, 9 Oct 2026: staff used to clock out an extra
    // time just to leave a note); it counts once a manager approves it. A small Google Apps Script (its own login) reads the
    // clock to send the alerts.
    // Managers: Dr. A and the people he makes time clock managers (isTcMgr()). Nobody corrects their own time except Dr. A.
    // the time clock's managers: Dr. A, and the people he picks (People → Edit). Amir, 9 Oct 2026: "right now the manager is
    // me, Dr. Akhavan" — approving time off (isHR) doesn't make someone a time clock manager.
    function isTcMgr() { return isOwner() || (isMember() && exists(/databases/$(db)/documents/tcMgrs/$(mySid()))); }
    function isKiosk() { return authed() && exists(/databases/$(db)/documents/tcKiosks/$(request.auth.uid)); }
    function isTcBot() { return authed() && exists(/databases/$(db)/documents/tcBots/$(request.auth.uid)); }
    function isTcDevice() { return isKiosk() || isTcBot(); }
    // an approved laptop (its own login, like a time-clock computer), and whether it's for this person (it reads and
    // punches only for the people Dr. A picked for it)
    function lapDoc() { return /databases/$(db)/documents/tcLaptops/$(request.auth.uid); }
    function isLaptop() { return authed() && exists(lapDoc()); }
    function lapHas(sid) { return sid in get(lapDoc()).data.sids; } // (not a laptop: no record, so refused)
    // a device that takes this person's PIN: a time-clock computer, or a laptop that's theirs
    function punchDev(sid) { return isKiosk() || lapHas(sid); }
    // the office check's login (the Worker), and what it wrote down: the network a login was on a moment ago
    function isNetBot() { return authed() && exists(/databases/$(db)/documents/tcNetBot/$(request.auth.uid)); }
    function okNet(s) { return s is string && s.matches('^(v4:[0-9]{1,3}([.][0-9]{1,3}){3}|v6:[0-9a-f]{1,4}(:[0-9a-f]{1,4}){3})$'); }
    function seenDoc(u) { return /databases/$(db)/documents/tcNetSeen/$(u); }
    function seenNet(u, m) { return request.time < get(seenDoc(u)).data.at + duration.value(m, 'm'); }
    // on the office network: the office check saw this login on a network Dr. A saved as the office's in the last 2
    // minutes, and gave its page this punch's number (pid) — so each check is good for one punch, and only for the page that
    // asked (nobody can read the numbers back)
    function atOffice(u, pid) {
      return seenNet(u, 2) && get(seenDoc(u)).data.pid == pid && exists(/databases/$(db)/documents/tcOffice/$(get(seenDoc(u)).data.net));
    }
    function tcSetDoc() { return /databases/$(db)/documents/meta/tc; }
    function lockOn() { return get(tcSetDoc()).data.get('lock', false) == true; }
    function tcStaffDoc(sid) { return /databases/$(db)/documents/tcStaff/$(sid); }
    function tcTryDoc(sid) { return /databases/$(db)/documents/tcTry/$(sid); }
    function tcTryPhDoc(sid) { return /databases/$(db)/documents/tcTryPh/$(sid); }
    function tcPinDoc(sid) { return /databases/$(db)/documents/tcPin/$(sid); }
    function okHM(s) { return s is string && (s == '' || s.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')); }
    // on the clock: Dr. A turned it on for them, and they're on the office's team (someone who left stops at once).
    // (Here and below, get() alone where a missing record should refuse anyway: each exists() and get() counts toward
    // the database's 10 look-ups for one save.)
    function onClock(sid) {
      return get(tcStaffDoc(sid)).data.on == true && get(/databases/$(db)/documents/roster/$(sid)).data.active == true;
    }
    // this time-clock computer just took this person's right PIN (within 5 minutes) ...
    function kioskOk(sid) {
      return get(tcTryDoc(sid)).data.ok == true && get(tcTryDoc(sid)).data.k == request.auth.uid
        && request.time < get(tcTryDoc(sid)).data.at + duration.value(5, 'm');
    }
    // ... and uses it up in the same save, for this one thing (u: the punch's id, or 'pin' for a new PIN)
    function tryUsed(sid, u) {
      return getAfter(tcTryDoc(sid)).data.ok == false && getAfter(tcTryDoc(sid)).data.n == 0 && getAfter(tcTryDoc(sid)).data.u == u;
    }

    // the clock's settings: the workweek, overtime and the heads-up hours, the boundaries, the office days, the pay period;
    // the office lock (on or off) and where the office check runs (a workers.dev address)
    match /meta/tc {
      function okTc() {
        let d = request.resource.data;
        return d.keys().hasOnly(['wk', 'ot', 'thr', 'early', 'late', 'shift', 'brk', 'days', 'pay', 'lock', 'wurl', 'at'])
          && (!('lock' in d) || d.lock is bool)
          && (!('wurl' in d) || (d.wurl is string && (d.wurl == '' || d.wurl.matches('^https://[a-z0-9-]{1,63}[.][a-z0-9-]{1,63}[.]workers[.]dev$'))))
          && d.wk is int && d.wk >= 0 && d.wk <= 6
          && d.ot is number && d.ot >= 20 && d.ot <= 80
          && d.thr is list && d.thr.size() <= 5
          && okHM(d.early) && okHM(d.late)
          && d.shift is number && d.shift >= 0 && d.shift <= 24
          && d.brk is int && d.brk >= 0 && d.brk <= 60
          && d.days is list && d.days.size() <= 7
          && d.pay is string && (d.pay == '' || d.pay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
          && d.at == request.time;
      }
      allow get: if isMember() || isTcDevice() || isLaptop();
      allow create, update: if isOwner() && okTc();
      allow delete: if false;
    }
    // where the alerts go (emails, the phone-push topic), which alerts go where, the daily summary's time, a test request
    match /meta/tcAlerts {
      function okAlerts() {
        let d = request.resource.data;
        return d.keys().hasOnly(['emails', 'topic', 'route', 'digest', 'test', 'at'])
          && d.emails is list && d.emails.size() <= 10
          && d.topic is string && d.topic.matches('^[A-Za-z0-9_-]{0,64}$')
          && d.route is map && d.route.size() <= 30
          && okHM(d.digest)
          && (!('test' in d) || d.test == null || d.test is timestamp)
          && d.at == request.time;
      }
      allow get: if isTcMgr() || isTcBot();
      allow create, update: if isOwner() && okAlerts();
      allow delete: if false;
    }
    // each person's clock settings: on the clock, may clock in from home (and on which days), their own earliest
    // clock-in, a weekly cap, salaried (hours kept for the record: no overtime), and when their PIN was last set
    match /tcStaff/{sid} {
      function okStaff() {
        let d = request.resource.data;
        return d.keys().hasOnly(['on', 'home', 'hdays', 'early', 'cap', 'sal', 'pinAt', 'pinBy', 'at', 'by'])
          && d.on is bool && d.home is bool && d.hdays is list && d.hdays.size() <= 7 && (!('sal' in d) || d.sal is bool)
          && (!('pinBy' in d) || d.pinBy in ['', 'mgr', 'self'])
          && okHM(d.early) && d.cap is number && d.cap >= 0 && d.cap <= 80
          && (d.pinAt == null || d.pinAt is timestamp)
          && d.at == request.time && d.by == request.auth.uid;
      }
      allow get, list: if isTcMgr() || isTcDevice() || (isMember() && sid == mySid());
      allow get: if lapHas(sid);
      // Dr. A decides who's on the clock, who may clock in from home, and their limits
      allow create, update: if isOwner() && okStaff() && sid.size() <= 40;
      // a PIN set by a manager, or changed by the person at the time clock (or their laptop) right after their PIN: only
      // pinAt (and who set it: the time clock nudges someone with a manager's PIN to pick their own) moves
      allow update: if okStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinAt', 'pinBy', 'at', 'by'])
        && request.resource.data.pinAt == request.time && existsAfter(tcPinDoc(sid))
        && ((request.resource.data.pinBy == 'mgr' && isTcMgr())
          || (request.resource.data.pinBy == 'self' && punchDev(sid) && kioskOk(sid) && tryUsed(sid, 'pin')));
      allow delete: if false;
    }
    // the PIN's hash: nobody can read it; the try rules below compare against it
    match /tcPin/{sid} {
      function okPin() {
        let d = request.resource.data;
        return d.keys().hasOnly(['h', 'at']) && d.h is string && d.h.matches('^[0-9a-f]{64}$') && d.at == request.time;
      }
      allow get, list: if false;
      // (a time clock or laptop: right after the person's PIN; anyone else: a manager)
      allow create, update: if okPin() && exists(tcStaffDoc(sid))
        && ((isKiosk() || isLaptop()) ? (punchDev(sid) && kioskOk(sid) && tryUsed(sid, 'pin')) : isTcMgr());
      allow delete: if isTcMgr();
    }
    // PIN tries at the time clock: counted before the PIN is checked, at most 5 in 10 minutes for each person. The hash of
    // the PIN tried goes in tcTryPh (same save), which nobody can read: anyone who could read it could work the PIN out.
    // bad: tries since the last right PIN (the alert script tells Dr. A when someone keeps trying a coworker's PIN).
    match /tcTry/{sid} {
      function okTry(d) {
        return d.keys().hasOnly(['n', 't0', 'at', 'ok', 'k', 'bad', 'u']) && d.n is int && d.t0 is timestamp && d.at is timestamp
          && d.ok is bool && d.k is string && d.bad is int && d.u is string && d.u.size() <= 30;
      }
      function aTry(d) {
        return d.ok == false && d.at == request.time && d.k == request.auth.uid && d.u == ''
          && existsAfter(tcTryPhDoc(sid)) && getAfter(tcTryPhDoc(sid)).data.at == request.time;
      }
      function cleared(d) { return d.n == 0 && d.ok == false && d.k == '' && d.at == request.time && d.t0 == request.time && d.bad == 0; }
      allow get, list: if isTcMgr() || isTcDevice();
      allow get: if lapHas(sid);
      allow create: if punchDev(sid) && onClock(sid) && okTry(request.resource.data) && aTry(request.resource.data)
        && request.resource.data.n == 1 && request.resource.data.t0 == request.time && request.resource.data.bad == 1;
      allow update: if punchDev(sid) && onClock(sid) && okTry(request.resource.data) && (
          // the next try: a fresh 10 minutes once the last ones are over, otherwise the count goes up (5 at most)
          (aTry(request.resource.data) && request.resource.data.bad == resource.data.bad + 1 && (
              (request.time > resource.data.t0 + duration.value(10, 'm') && request.resource.data.n == 1 && request.resource.data.t0 == request.time)
           || (resource.data.n < 5 && request.resource.data.n == resource.data.n + 1 && request.resource.data.t0 == resource.data.t0)))
          // the check: only "ok" changes, and only when the PIN tried (already counted, its hash saved with it) is the right one
       || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ok']) && request.resource.data.ok == true
              && resource.data.ok == false && resource.data.k == request.auth.uid
              && request.time < resource.data.at + duration.value(2, 'm')
              && get(tcTryPhDoc(sid)).data.at == resource.data.at && get(tcTryPhDoc(sid)).data.ph == get(tcPinDoc(sid)).data.h)
          // used up after a right PIN (u: the punch, or 'pin' for a new PIN; '' if they walked away): no tries left over
       || (resource.data.ok == true && resource.data.k == request.auth.uid && cleared(request.resource.data)));
      // a manager clears a lockout
      allow update: if request.resource.data.u == '' && okTry(request.resource.data) && cleared(request.resource.data) && isTcMgr();
      allow delete: if isTcMgr();
    }
    // the hash of the PIN just tried: written with its try, never readable (the check above compares it with tcPin)
    match /tcTryPh/{sid} {
      allow get, list: if false;
      allow create, update: if punchDev(sid) && onClock(sid) && request.resource.data.keys().hasOnly(['ph', 'at'])
        && request.resource.data.ph is string && request.resource.data.ph.matches('^[0-9a-f]{64}$') && request.resource.data.at == request.time
        && existsAfter(tcTryDoc(sid)) && getAfter(tcTryDoc(sid)).data.at == request.time
        && getAfter(tcTryDoc(sid)).data.k == request.auth.uid && getAfter(tcTryDoc(sid)).data.ok == false && getAfter(tcTryDoc(sid)).data.n > 0;
      allow delete: if isTcMgr();
    }
    // punches: the server's time; never changed or deleted. net: where it came from — 'office' (the office check saw this
    // login on the office network in the last 2 minutes), 'off' (another network), 'unk' (it couldn't be checked), ''
    // (the office lock is off: not checked)
    match /tcPunch/{id} {
      function okPunch() {
        let d = request.resource.data;
        return id.matches('^p[0-9a-f]{24}$') && d.keys().hasOnly(['sid', 'kind', 'at', 'src', 'by', 'net'])
          && d.sid is string && d.kind in ['in', 'lunch', 'back', 'out'] && d.at == request.time && d.by == request.auth.uid
          && d.net in ['', 'office', 'off', 'unk'] && onClock(d.sid);
      }
      allow get, list: if isTcMgr() || isTcDevice() || (isMember() && resource.data.sid == mySid()) || lapHas(resource.data.sid);
      // at the time clock, right after the person's PIN (the try is used up in the same save). It's never refused for the
      // network: off the office network (moved, or the office's internet changed) it goes through, flagged ('off', 'unk').
      allow create: if request.resource.data.src == 'kiosk' && isKiosk() && okPunch()
        && kioskOk(request.resource.data.sid) && tryUsed(request.resource.data.sid, id)
        && ((request.resource.data.net == 'office' && atOffice(request.auth.uid, id)) || request.resource.data.net in ['off', 'unk']
          || (request.resource.data.net == '' && !lockOn()));
      // on their own phone or computer, signed in, for themselves: only with the office lock on, on the office network
      allow create: if request.resource.data.src == 'own' && isMember() && okPunch() && request.resource.data.sid == mySid()
        && request.resource.data.net == 'office' && lockOn() && atOffice(request.auth.uid, id);
      // on a laptop Dr. A approved, for the people he picked, right after their PIN: at the office like the time clock;
      // anywhere else (marked Home) only for someone he allows home, and only clocking in or out
      allow create: if request.resource.data.src == 'laptop' && lapHas(request.resource.data.sid) && okPunch()
        && kioskOk(request.resource.data.sid) && tryUsed(request.resource.data.sid, id)
        && ((request.resource.data.net == 'office' && atOffice(request.auth.uid, id))
          || (request.resource.data.net in ['', 'off', 'unk'] && request.resource.data.kind in ['in', 'out']
            && get(tcStaffDoc(request.resource.data.sid)).data.home == true));
      allow update, delete: if false;
    }
    // corrections: a punch added (with its time) or one taken out, each with who, when and why; never changed or deleted
    match /tcFix/{id} {
      function okFix() {
        let d = request.resource.data;
        return id.matches('^f[0-9a-f]{24}$') && d.keys().hasOnly(['sid', 'op', 'ref', 'kind', 't', 'why', 'by', 'bsid', 'at'])
          && d.sid is string && d.sid.size() > 0 && d.sid.size() <= 40 && exists(tcStaffDoc(d.sid))
          && d.why is string && d.why.size() > 0 && d.why.size() <= 300
          && d.by == request.auth.uid && d.bsid == mySid() && d.at == request.time
          && ((d.op == 'add' && d.kind in ['in', 'lunch', 'back', 'out'] && d.ref == ''
                && d.t is int && d.t > 946684800000 && d.t < request.time.toMillis() + 3600000)
           || (d.op == 'void' && d.kind == '' && d.t == 0 && (
                 (d.ref.matches('^p[0-9a-f]{24}$') && exists(/databases/$(db)/documents/tcPunch/$(d.ref))
                   && get(/databases/$(db)/documents/tcPunch/$(d.ref)).data.sid == d.sid)
              || (d.ref.matches('^f[0-9a-f]{24}$') && exists(/databases/$(db)/documents/tcFix/$(d.ref))
                   && get(/databases/$(db)/documents/tcFix/$(d.ref)).data.sid == d.sid
                   && get(/databases/$(db)/documents/tcFix/$(d.ref)).data.op == 'add'))));
      }
      allow get, list: if isTcMgr() || isTcDevice() || (isMember() && resource.data.sid == mySid()) || lapHas(resource.data.sid);
      allow create: if isTcMgr() && okFix() && (request.resource.data.sid != mySid() || isOwner());
      allow update, delete: if false;
    }
    // overtime approved ahead of time for one person and one workweek (id: <staff id>_<first day of the week>)
    match /tcOT/{id} {
      function okOT() {
        let d = request.resource.data;
        return d.keys().hasOnly(['sid', 'week', 'hrs', 'why', 'by', 'bsid', 'at'])
          && d.sid is string && d.week is string && d.week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && id == d.sid + '_' + d.week
          && d.hrs is number && d.hrs >= 20 && d.hrs <= 80 && d.why is string && d.why.size() <= 300
          && d.by == request.auth.uid && d.bsid == mySid() && d.at == request.time;
      }
      allow get, list: if isTcMgr() || isTcDevice() || (isMember() && resource.data.sid == mySid()) || lapHas(resource.data.sid);
      allow create, update: if isTcMgr() && okOT() && (request.resource.data.sid != mySid() || isOwner());
      allow delete: if isTcMgr() && (resource.data.sid != mySid() || isOwner());
    }
    // asking a manager to fix their time: the punches they missed (at most 2, from the last 31 days; none = just a note).
    // It changes nobody's time: a manager approves it (the punches are added as corrections in the same save) or declines it.
    function kioskAsk(sid) {
      return get(tcTryDoc(sid)).data.ok == true && get(tcTryDoc(sid)).data.k == request.auth.uid
        && request.time < get(tcTryDoc(sid)).data.at + duration.value(10, 'm');
    }
    function tcReqNDoc(sid) { return /databases/$(db)/documents/tcReqN/$(sid); }
    // at most 10 requests in 24 hours for each person, counted in the same save (like the PIN tries)
    function reqCounted(sid) {
      let a = getAfter(tcReqNDoc(sid)).data;
      return a.at == request.time && (
          (!exists(tcReqNDoc(sid)) && a.n == 1 && a.t0 == request.time)
       || (exists(tcReqNDoc(sid)) && (
             (request.time > get(tcReqNDoc(sid)).data.t0 + duration.value(24, 'h') && a.n == 1 && a.t0 == request.time)
          || (get(tcReqNDoc(sid)).data.n < 10 && a.n == get(tcReqNDoc(sid)).data.n + 1 && a.t0 == get(tcReqNDoc(sid)).data.t0))));
    }
    // a correction an approval names: added for this person in the same save
    function okFxOf(f, sid) {
      return f is string && f.matches('^f[0-9a-f]{24}$') && existsAfter(/databases/$(db)/documents/tcFix/$(f))
        && getAfter(/databases/$(db)/documents/tcFix/$(f)).data.sid == sid && getAfter(/databases/$(db)/documents/tcFix/$(f)).data.op == 'add';
    }
    match /tcReqN/{sid} {
      allow get: if isTcMgr() || isTcDevice() || (isMember() && sid == mySid()) || lapHas(sid);
      // only with a request of theirs in the same save (nobody can use up a coworker's)
      allow create, update: if request.resource.data.keys().hasOnly(['n', 't0', 'at']) && request.resource.data.n is int
        && request.resource.data.t0 is timestamp && request.resource.data.at == request.time
        && ((isMember() && sid == mySid()) || (punchDev(sid) && kioskAsk(sid)));
      allow delete: if false;
    }
    match /tcReq/{id} {
      function okAsk(p) {
        return p is map && p.keys().hasOnly(['k', 't']) && p.k in ['in', 'lunch', 'back', 'out'] && p.t is int
          && p.t > request.time.toMillis() - 2678400000 && p.t < request.time.toMillis() + 3600000;
      }
      function okReq() {
        let d = request.resource.data;
        return id.matches('^r[0-9a-f]{24}$') && d.keys().hasOnly(['sid', 'ps', 'note', 'src', 'by', 'at', 'st'])
          && d.sid is string && onClock(d.sid)
          && d.ps is list && d.ps.size() <= 2 && (d.ps.size() < 1 || okAsk(d.ps[0])) && (d.ps.size() < 2 || okAsk(d.ps[1]))
          && d.note is string && d.note.size() <= 200 && (d.ps.size() > 0 || d.note.size() > 0)
          && d.by == request.auth.uid && d.at == request.time && d.st == 'open';
      }
      allow get, list: if isTcMgr() || isTcDevice() || (isMember() && resource.data.sid == mySid()) || lapHas(resource.data.sid);
      // at the time clock (or their approved laptop), after the person's PIN (the form takes a moment: up to 10 minutes;
      // the PIN isn't used up)
      allow create: if ((request.resource.data.src == 'kiosk' && isKiosk()) || (request.resource.data.src == 'laptop' && lapHas(request.resource.data.sid))) && okReq()
        && kioskAsk(request.resource.data.sid) && reqCounted(request.resource.data.sid);
      // signed in with their own login, for themselves
      allow create: if isMember() && okReq() && request.resource.data.src == 'me' && request.resource.data.sid == mySid()
        && reqCounted(request.resource.data.sid);
      // a manager answers it, once (their own only Dr. A answers): approved (with the corrections for each punch asked for,
      // in the same save) or declined, with an optional note
      allow update: if isTcMgr() && (resource.data.sid != mySid() || isOwner()) && resource.data.st == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'rby', 'rbsid', 'rat', 'rwhy', 'fx'])
        && request.resource.data.st in ['ok', 'no'] && request.resource.data.rby == request.auth.uid
        && request.resource.data.rbsid == mySid() && request.resource.data.rat == request.time
        && request.resource.data.rwhy is string && request.resource.data.rwhy.size() <= 300 && request.resource.data.fx is list
        && ((request.resource.data.st == 'no' && request.resource.data.fx.size() == 0)
         || (request.resource.data.st == 'ok' && request.resource.data.fx.size() == resource.data.ps.size()
             && (resource.data.ps.size() < 1 || okFxOf(request.resource.data.fx[0], resource.data.sid))
             && (resource.data.ps.size() < 2 || okFxOf(request.resource.data.fx[1], resource.data.sid))));
      // the person takes it back while it waits
      allow update: if resource.data.st == 'open' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'rat'])
        && request.resource.data.st == 'x' && request.resource.data.rat == request.time
        && ((isMember() && resource.data.sid == mySid()) || (punchDev(resource.data.sid) && kioskAsk(resource.data.sid)));
      allow delete: if false;
    }
    // the alerts sent (each one once: the script claims it here before sending it)
    match /tcSent/{id} {
      function okSent(d) {
        return d.keys().hasOnly(['k', 'type', 'sid', 'text', 'st', 'ch', 'at', 'up'])
          && d.k is string && d.k.size() <= 160 && d.type is string && d.type.size() <= 20 && d.sid is string && d.sid.size() <= 40
          && d.text is string && d.text.size() <= 600 && d.st in ['claim', 'sent', 'fail'] && d.ch is int && d.up == request.time;
      }
      allow get, list: if isTcMgr() || isTcBot();
      allow create: if isTcBot() && id.matches('^a[0-9a-f]{32}$') && okSent(request.resource.data)
        && request.resource.data.st == 'claim' && request.resource.data.at == request.time;
      allow update: if isTcBot() && okSent(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'ch', 'up', 'text']);
      allow delete: if isOwner();
    }
    // when the alert script last checked (and any problem it hit)
    match /tcBeat/{uid} {
      allow get, list: if isTcMgr();
      allow create, update: if isTcBot() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['box', 'ver', 'err', 'sent', 'at'])
        && request.resource.data.box is string && request.resource.data.box.size() <= 120
        && request.resource.data.ver is string && request.resource.data.ver.size() <= 20
        && request.resource.data.err is string && request.resource.data.err.size() <= 300
        && request.resource.data.sent is int && request.resource.data.at == request.time;
      allow delete: if isOwner();
    }
    // who manages the time clock besides Dr. A (by staff id): only he adds or removes them
    match /tcMgrs/{sid} {
      allow get: if isTcMgr() || (isMember() && sid == mySid());
      allow list: if isTcMgr();
      allow create: if isOwner() && request.resource.data.keys().hasOnly(['at', 'by']) && request.resource.data.at == request.time
        && request.resource.data.by == request.auth.uid && exists(tcStaffDoc(sid));
      allow update: if false;
      allow delete: if isOwner();
    }
    // the office's time-clock computers (each its own login, made by Dr. A on that computer)
    match /tcKiosks/{uid} {
      allow get: if isTcMgr() || (authed() && request.auth.uid == uid);
      allow list: if isTcMgr() || isTcBot();
      allow create: if isOwner() && request.resource.data.keys().hasOnly(['name', 'at', 'by'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.at == request.time && request.resource.data.by == request.auth.uid;
      allow update: if (isOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
            && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40)
        || (authed() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen'])
            && request.resource.data.seen == request.time);
      allow delete: if isOwner();
    }
    // the alert script's login (made by Dr. A)
    match /tcBots/{uid} {
      allow get: if authed() && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();
      allow create: if isOwner() && request.resource.data.keys().hasOnly(['email', 'at'])
        && request.resource.data.email is string && request.resource.data.email.size() <= 120 && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if isOwner();
    }
    // approved laptops (Amir, 9 Oct 2026: the laptop one of his assistants uses to work from home sometimes, and the one
    // a teammate who works from home uses): each its own login, made on that laptop and approved by Dr. A with the code it
    // shows, for the people he picked — a time clock that also works away from the office. He renames one, changes who
    // uses it, or takes it back (a lost laptop, someone leaving).
    match /tcLaptops/{uid} {
      function okLap(d) {
        return d.name is string && d.name.size() > 0 && d.name.size() <= 40 && d.sids is list && d.sids.size() > 0 && d.sids.size() <= 4
          && d.sids[0] is string && d.sids[0].size() <= 40 && (d.sids.size() < 2 || (d.sids[1] is string && d.sids[1].size() <= 40))
          && (d.sids.size() < 3 || (d.sids[2] is string && d.sids[2].size() <= 40)) && (d.sids.size() < 4 || (d.sids[3] is string && d.sids[3].size() <= 40));
      }
      allow get: if isTcMgr() || (authed() && request.auth.uid == uid);
      allow list: if isTcMgr() || isTcBot();
      // (only a laptop asking for it in the last 30 minutes: Dr. A types the code it shows)
      allow create: if isOwner() && request.resource.data.keys().hasOnly(['name', 'sids', 'at', 'by']) && okLap(request.resource.data)
        && request.resource.data.at == request.time && request.resource.data.by == request.auth.uid
        && request.time < get(/databases/$(db)/documents/tcLapReq/$(uid)).data.at + duration.value(30, 'm');
      allow update: if (isOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'sids']) && okLap(request.resource.data))
        || (authed() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen'])
            && request.resource.data.seen == request.time);
      allow delete: if isOwner();
    }
    // a laptop asking to be approved: its own new login, made on that laptop, and a 6-digit code it shows, so Dr. A approves
    // the right one on his own phone or computer (his password never goes on the laptop). Anyone can make a login, so a
    // request says nothing but its code and which browser it is (no words of its own to show Dr. A), each login asks once,
    // and only Dr. A clears requests.
    match /tcLapReq/{uid} {
      allow get: if authed() && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();
      allow create: if authed() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['code', 'dev', 'at'])
        && request.resource.data.code is string && request.resource.data.code.matches('^[0-9]{6}$')
        && request.resource.data.dev is string
        && request.resource.data.dev.matches('^(Edge|Opera|Firefox|Chrome|Safari|A browser)( on (iPhone|iPad|Android|a Chromebook|Windows|a Mac|Linux))?$')
        && request.resource.data.at == request.time
        && !exists(/databases/$(db)/documents/members/$(uid));
      allow update: if false;
      allow delete: if isOwner();
    }
    // the office check's login (made by Dr. A: Settings → Office network). It reads which networks are the office's and
    // writes down the network a login was on, nothing else.
    match /tcNetBot/{uid} {
      allow get: if authed() && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();
      allow create: if isOwner() && request.resource.data.keys().hasOnly(['email', 'at'])
        && request.resource.data.email is string && request.resource.data.email.size() <= 120 && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if isOwner();
    }
    // the network a login was on a moment ago, with the database's time and the one-time punch number its page was given
    // (the office check writes it right before a punch). Only Dr. A reads them (nobody can read a punch number back), and
    // only for the office's people and devices (a login anyone could make gets nothing written).
    match /tcNetSeen/{uid} {
      allow get: if isOwner();
      allow create, update: if isNetBot() && request.resource.data.keys().hasOnly(['net', 'office', 'org', 'city', 'pid', 'relay', 'at'])
        && okNet(request.resource.data.net) && request.resource.data.office is bool
        && request.resource.data.org is string && request.resource.data.org.size() <= 100
        && request.resource.data.city is string && request.resource.data.city.size() <= 60
        && request.resource.data.pid is string && request.resource.data.pid.matches('^p[0-9a-f]{24}$') && request.resource.data.relay is bool
        && request.resource.data.at == request.time
        && (exists(/databases/$(db)/documents/members/$(uid)) || exists(/databases/$(db)/documents/tcKiosks/$(uid)) || exists(/databases/$(db)/documents/tcLaptops/$(uid)));
      allow delete: if isOwner();
    }
    // the office's networks: Dr. A saves the one he's on right now ("This is the office" — never an address many people
    // share, like iCloud Private Relay or a VPN); he can rename or remove one
    match /tcOffice/{net} {
      function okOffice(d) {
        return okNet(net) && d.keys().hasOnly(['name', 'org', 'city', 'by', 'at'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 40
          && d.org is string && d.org.size() <= 100 && d.city is string && d.city.size() <= 60
          && d.by == request.auth.uid && d.at == request.time;
      }
      allow get, list: if isOwner() || isNetBot();
      allow create: if isOwner() && okOffice(request.resource.data) && seenNet(request.auth.uid, 5)
        && get(seenDoc(request.auth.uid)).data.net == net && get(seenDoc(request.auth.uid)).data.relay == false;
      allow update: if isOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40;
      allow delete: if isOwner();
    }
    // which set of these rules is live (the page reads this; older rules refuse it)
    match /meta/rules_tc_1 {
      allow get: if isMember() || isTcDevice();
    }
    match /meta/rules_tc_2 {
      allow get: if isMember() || isTcDevice() || isLaptop() || isNetBot();
    }
  }
}
