{
 "rules": {
  "nlo": {
   "items": {
    ".read": "auth != null",
    ".write": "auth != null && auth.token.email_verified == true && (auth.token.email === 'akhavan.ak@gmail.com' || auth.token.email === 'records@thenextlevelorthodontics.com')"
   },
   "settings": {
    ".read": "auth != null && auth.token.email_verified == true && (auth.token.email === 'akhavan.ak@gmail.com' || auth.token.email === 'records@thenextlevelorthodontics.com')",
    ".write": "auth != null && auth.token.email_verified == true && (auth.token.email === 'akhavan.ak@gmail.com' || auth.token.email === 'records@thenextlevelorthodontics.com')"
   },
   "checklistApp": {
    ".read": "auth != null && auth.token.email_verified == true && (auth.token.email === 'akhavan.ak@gmail.com' || auth.token.email.endsWith('@thenextlevelorthodontics.com'))",
    ".write": "auth != null && auth.token.email_verified == true && (auth.token.email === 'akhavan.ak@gmail.com' || auth.token.email.endsWith('@thenextlevelorthodontics.com'))"
   },
   "cadence": {
    ".read": "auth != null && auth.token.email_verified == true && (auth.token.email === 'akhavan.ak@gmail.com' || auth.token.email.endsWith('@thenextlevelorthodontics.com'))",
    ".write": "auth != null && auth.token.email_verified == true && (auth.token.email === 'akhavan.ak@gmail.com' || auth.token.email.endsWith('@thenextlevelorthodontics.com'))"
   },
   "staffMeeting": {
    ".read": "auth != null && auth.token.email_verified == true && (auth.token.email === 'akhavan.ak@gmail.com' || auth.token.email.endsWith('@thenextlevelorthodontics.com'))",
    ".write": "auth != null && auth.token.email_verified == true && (auth.token.email === 'akhavan.ak@gmail.com' || auth.token.email.endsWith('@thenextlevelorthodontics.com'))"
   },
   "ipr": {
    ".read": "auth != null && auth.token.email_verified == true && (auth.token.email === 'akhavan.ak@gmail.com' || auth.token.email.endsWith('@thenextlevelorthodontics.com'))",
    ".write": "auth != null && auth.token.email_verified == true && (auth.token.email === 'akhavan.ak@gmail.com' || auth.token.email.endsWith('@thenextlevelorthodontics.com'))"
   },
   "calendar": {
    ".read": "auth != null && auth.token.email_verified == true && (auth.token.email === 'akhavan.ak@gmail.com' || auth.token.email.endsWith('@thenextlevelorthodontics.com'))",
    ".write": "auth != null && auth.token.email_verified == true && (auth.token.email === 'akhavan.ak@gmail.com' || auth.token.email.endsWith('@thenextlevelorthodontics.com'))"
   },
   "onboarding": {
    ".read": "auth != null && auth.token.email_verified == true && (auth.token.email === 'akhavan.ak@gmail.com' || auth.token.email.endsWith('@thenextlevelorthodontics.com'))",
    ".write": "auth != null && auth.token.email_verified == true && (auth.token.email === 'akhavan.ak@gmail.com' || auth.token.email.endsWith('@thenextlevelorthodontics.com'))",
    "keys": {
     "$key": {
      ".read": "auth != null"
     }
    },
    "devices": {
     "$uid": {
      ".read": "auth != null && auth.uid === $uid",
      ".write": "auth != null && auth.uid === $uid"
     }
    },
    "people": {
     "$rid": {
      ".read": "auth != null && root.child('nlo/onboarding/devices').child(auth.uid).child('rid').val() === $rid",
      "progress": {
       ".write": "auth != null && root.child('nlo/onboarding/devices').child(auth.uid).child('rid').val() === $rid"
      },
      "log": {
       ".write": "auth != null && root.child('nlo/onboarding/devices').child(auth.uid).child('rid').val() === $rid"
      }
     }
    },
    "catalog": {
     ".read": "auth != null && root.child('nlo/onboarding/devices').child(auth.uid).child('key').isString()"
    },
    "settings": {
     ".read": "auth != null && root.child('nlo/onboarding/devices').child(auth.uid).child('key').isString()"
    }
   }
  }
 }
}